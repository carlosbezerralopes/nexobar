<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting><UseWinUI>true</UseWinUI><WinUISDKReferences>false</WinUISDKReferences>
    <ApplicationManifest>app.manifest</ApplicationManifest><Platforms>x64;ARM64</Platforms><RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <RestoreLockedMode>true</RestoreLockedMode>
    <WidBarPluginId>com.nexobar.indicators</WidBarPluginId><WidBarPluginName>NexoBar</WidBarPluginName>
    <WidBarPluginDescription>Indicadores locais coletados pelo NexoBar.</WidBarPluginDescription><WidBarPluginCategory>System</WidBarPluginCategory>
    <Version>0.5.0</Version><WidBarPluginVersion>0.5.0</WidBarPluginVersion><WidBarPluginPreviewWidth>320</WidBarPluginPreviewWidth><WidBarPluginConfigurable>true</WidBarPluginConfigurable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ContractBuild)' == 'true'">
    <UseWinUI>false</UseWinUI><OutputType>Library</OutputType><WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained><SelfContained>false</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling><WindowsAppSDKGeneratePriEnabled>false</WindowsAppSDKGeneratePriEnabled>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs" /><ApplicationDefinition Include="WidgetApp.xaml" Condition="'$(ContractBuild)' != 'true'" /><Page Remove="WidgetApp.xaml" /><Manifest Include="$(ApplicationManifest)" /></ItemGroup>
  <ItemGroup Condition="'$(ContractBuild)' == 'true'"><Compile Remove="Program.cs;WidgetApp.xaml.cs" /></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" /><PackageReference Include="WidBar.SDK" Version="2.1.0" /><ProjectReference Include="../core/NexoBar.Core.csproj" /></ItemGroup>
</Project>
